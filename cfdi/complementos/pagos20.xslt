<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:pago20="http://www.sat.gob.mx/Pagos20" xmlns:cfdi="http://www.sat.gob.mx/cfd/4" exclude-result-prefixes="pago20 cfdi">
    <xsl:template match="pago20:Pagos" mode="cfdi:pagos20"><section class="cfdi-panel cfdi-pagos20" aria-label="Complemento de pagos 2.0"><h2>Complemento para recepción de pagos 2.0</h2><xsl:apply-templates select="pago20:Totales" mode="cfdi:pagos20-totales"/><xsl:apply-templates select="pago20:Pago" mode="cfdi:pagos20-pago"/></section></xsl:template>
    <xsl:template match="pago20:Totales" mode="cfdi:pagos20-totales"><article class="cfdi-payment-totals"><h3>Totales del complemento</h3><div class="cfdi-data-grid"><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Total retenciones IVA'"/><xsl:with-param name="value" select="@TotalRetencionesIVA"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Total retenciones ISR'"/><xsl:with-param name="value" select="@TotalRetencionesISR"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Total retenciones IEPS'"/><xsl:with-param name="value" select="@TotalRetencionesIEPS"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Total traslados base IVA 16%'"/><xsl:with-param name="value" select="@TotalTrasladosBaseIVA16"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Total traslados impuesto IVA 16%'"/><xsl:with-param name="value" select="@TotalTrasladosImpuestoIVA16"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Total traslados base IVA 8%'"/><xsl:with-param name="value" select="@TotalTrasladosBaseIVA8"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Total traslados impuesto IVA 8%'"/><xsl:with-param name="value" select="@TotalTrasladosImpuestoIVA8"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Total traslados base IVA 0%'"/><xsl:with-param name="value" select="@TotalTrasladosBaseIVA0"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Total traslados impuesto IVA 0%'"/><xsl:with-param name="value" select="@TotalTrasladosImpuestoIVA0"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Total traslados base IVA exento'"/><xsl:with-param name="value" select="@TotalTrasladosBaseIVAExento"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Monto total pagos'"/><xsl:with-param name="value" select="@MontoTotalPagos"/><xsl:with-param name="class" select="'cfdi-total-field'"/></xsl:call-template></div></article></xsl:template>
    <xsl:template match="pago20:Pago" mode="cfdi:pagos20-pago"><article class="cfdi-payment"><h3>Pago</h3><div class="cfdi-data-grid"><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Fecha de pago'"/><xsl:with-param name="value" select="@FechaPago"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Forma de pago'"/><xsl:with-param name="value" select="@FormaDePagoP"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Moneda'"/><xsl:with-param name="value" select="@MonedaP"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Tipo cambio'"/><xsl:with-param name="value" select="@TipoCambioP"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Monto'"/><xsl:with-param name="value" select="@Monto"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'No. operación'"/><xsl:with-param name="value" select="@NumOperacion"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'RFC emisor cuenta ordenante'"/><xsl:with-param name="value" select="@RfcEmisorCtaOrd"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Cuenta ordenante'"/><xsl:with-param name="value" select="@CtaOrdenante"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'RFC emisor cuenta beneficiario'"/><xsl:with-param name="value" select="@RfcEmisorCtaBen"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Cuenta beneficiario'"/><xsl:with-param name="value" select="@CtaBeneficiario"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Tipo cadena pago'"/><xsl:with-param name="value" select="@TipoCadPago"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Certificado pago'"/><xsl:with-param name="value" select="@CertPago"/><xsl:with-param name="class" select="'cfdi-wide'"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Cadena pago'"/><xsl:with-param name="value" select="@CadPago"/><xsl:with-param name="class" select="'cfdi-wide'"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Sello pago'"/><xsl:with-param name="value" select="@SelloPago"/><xsl:with-param name="class" select="'cfdi-wide'"/></xsl:call-template></div><xsl:apply-templates select="pago20:DoctoRelacionado" mode="cfdi:pagos20-docto"/><xsl:apply-templates select="pago20:ImpuestosP" mode="cfdi:pagos20-impuestos"/></article></xsl:template>
    <xsl:template match="pago20:DoctoRelacionado" mode="cfdi:pagos20-docto"><section class="cfdi-payment-document"><h4>Documento relacionado</h4><div class="cfdi-table-wrap"><table class="cfdi-table cfdi-payment-document-table"><thead><tr><th>Id documento</th><th>Serie</th><th>Folio</th><th>Moneda</th><th>Equivalencia</th><th>Núm. parcialidad</th><th>Saldo anterior</th><th>Importe pagado</th><th>Saldo insoluto</th><th>Objeto imp.</th></tr></thead><tbody><tr><td><xsl:value-of select="@IdDocumento"/></td><td><xsl:value-of select="@Serie"/></td><td><xsl:value-of select="@Folio"/></td><td><xsl:value-of select="@MonedaDR"/></td><td><xsl:value-of select="@EquivalenciaDR"/></td><td><xsl:value-of select="@NumParcialidad"/></td><td class="cfdi-money"><xsl:call-template name="cfdi-money"><xsl:with-param name="value" select="@ImpSaldoAnt"/></xsl:call-template></td><td class="cfdi-money"><xsl:call-template name="cfdi-money"><xsl:with-param name="value" select="@ImpPagado"/></xsl:call-template></td><td class="cfdi-money"><xsl:call-template name="cfdi-money"><xsl:with-param name="value" select="@ImpSaldoInsoluto"/></xsl:call-template></td><td><xsl:value-of select="@ObjetoImpDR"/></td></tr></tbody></table></div><xsl:apply-templates select="pago20:ImpuestosDR" mode="cfdi:pagos20-impuestos-dr"/></section></xsl:template>
    <xsl:template match="pago20:ImpuestosDR" mode="cfdi:pagos20-impuestos-dr"><div class="cfdi-payment-tax-detail"><xsl:if test="pago20:RetencionesDR/pago20:RetencionDR"><h5>Retenciones DR</h5><xsl:call-template name="cfdi-pagos20-tax-table"><xsl:with-param name="nodes" select="pago20:RetencionesDR/pago20:RetencionDR"/></xsl:call-template></xsl:if><xsl:if test="pago20:TrasladosDR/pago20:TrasladoDR"><h5>Traslados DR</h5><xsl:call-template name="cfdi-pagos20-tax-table"><xsl:with-param name="nodes" select="pago20:TrasladosDR/pago20:TrasladoDR"/></xsl:call-template></xsl:if></div></xsl:template>
    <xsl:template match="pago20:ImpuestosP" mode="cfdi:pagos20-impuestos"><section class="cfdi-payment-tax-detail"><h4>Impuestos del pago</h4><xsl:if test="pago20:RetencionesP/pago20:RetencionP"><h5>Retenciones P</h5><xsl:call-template name="cfdi-pagos20-tax-table"><xsl:with-param name="nodes" select="pago20:RetencionesP/pago20:RetencionP"/></xsl:call-template></xsl:if><xsl:if test="pago20:TrasladosP/pago20:TrasladoP"><h5>Traslados P</h5><xsl:call-template name="cfdi-pagos20-tax-table"><xsl:with-param name="nodes" select="pago20:TrasladosP/pago20:TrasladoP"/></xsl:call-template></xsl:if></section></xsl:template>
    <xsl:template name="cfdi-pagos20-tax-table"><xsl:param name="nodes"/><div class="cfdi-table-wrap"><table class="cfdi-table cfdi-small-table"><thead><tr><th>Base</th><th>Impuesto</th><th>Tipo factor</th><th>Tasa o cuota</th><th>Importe</th></tr></thead><tbody><xsl:for-each select="$nodes"><tr><td class="cfdi-money"><xsl:call-template name="cfdi-money"><xsl:with-param name="value" select="@BaseDR | @BaseP"/></xsl:call-template></td><td><xsl:value-of select="@ImpuestoDR | @ImpuestoP"/></td><td><xsl:value-of select="@TipoFactorDR | @TipoFactorP"/></td><td class="cfdi-number"><xsl:call-template name="cfdi-rate"><xsl:with-param name="value" select="@TasaOCuotaDR | @TasaOCuotaP"/></xsl:call-template></td><td class="cfdi-money"><xsl:call-template name="cfdi-money"><xsl:with-param name="value" select="@ImporteDR | @ImporteP"/></xsl:call-template></td></tr></xsl:for-each></tbody></table></div></xsl:template>
</xsl:stylesheet>
