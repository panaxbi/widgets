<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:cfdi="http://www.sat.gob.mx/cfd/4" exclude-result-prefixes="cfdi">
    <xsl:template match="cfdi:Comprobante" mode="cfdi:comprobante"><section class="cfdi-panel cfdi-comprobante" aria-label="Datos del comprobante"><h2>Comprobante</h2><div class="cfdi-data-grid"><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Serie'"/><xsl:with-param name="value" select="@Serie"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Folio'"/><xsl:with-param name="value" select="@Folio"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Tipo de comprobante'"/><xsl:with-param name="value" select="@TipoDeComprobante"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Lugar de expedición'"/><xsl:with-param name="value" select="@LugarExpedicion"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Moneda'"/><xsl:with-param name="value" select="@Moneda"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Tipo de cambio'"/><xsl:with-param name="value" select="@TipoCambio"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Forma de pago'"/><xsl:with-param name="value" select="@FormaPago"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Método de pago'"/><xsl:with-param name="value" select="@MetodoPago"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Exportación'"/><xsl:with-param name="value" select="@Exportacion"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'No. certificado'"/><xsl:with-param name="value" select="@NoCertificado"/><xsl:with-param name="class" select="'cfdi-wide'"/></xsl:call-template></div><xsl:if test="cfdi:CfdiRelacionados"><div class="cfdi-related"><h3>CFDI relacionados</h3><xsl:for-each select="cfdi:CfdiRelacionados"><div class="cfdi-related-type">Tipo relación: <strong><xsl:value-of select="@TipoRelacion"/></strong></div><ul><xsl:for-each select="cfdi:CfdiRelacionado"><li><xsl:value-of select="@UUID"/></li></xsl:for-each></ul></xsl:for-each></div></xsl:if></section></xsl:template>
</xsl:stylesheet>
