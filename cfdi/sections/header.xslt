<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:cfdi="http://www.sat.gob.mx/cfd/4" xmlns:tfd="http://www.sat.gob.mx/TimbreFiscalDigital" exclude-result-prefixes="cfdi tfd">
<xsl:template match="cfdi:Comprobante" mode="cfdi:header"><header class="cfdi-reference-header" aria-label="Datos fiscales"><div><xsl:call-template name="cfdi-field"><xsl:with-param name="label">RFC emisor:</xsl:with-param><xsl:with-param name="value" select="cfdi:Emisor/@Rfc"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label">Nombre emisor:</xsl:with-param><xsl:with-param name="value" select="cfdi:Emisor/@Nombre"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label">RFC receptor:</xsl:with-param><xsl:with-param name="value" select="cfdi:Receptor/@Rfc"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label">Nombre receptor:</xsl:with-param><xsl:with-param name="value" select="cfdi:Receptor/@Nombre"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label">C&#243;digo postal del receptor:</xsl:with-param><xsl:with-param name="value" select="cfdi:Receptor/@DomicilioFiscalReceptor"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label">R&#233;gimen fiscal receptor:</xsl:with-param><xsl:with-param name="value"><xsl:apply-templates select="cfdi:Receptor/@RegimenFiscalReceptor" mode="cfdi:reference-label"/></xsl:with-param></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label">Uso CFDI:</xsl:with-param><xsl:with-param name="value"><xsl:apply-templates select="cfdi:Receptor/@UsoCFDI" mode="cfdi:reference-label"/></xsl:with-param></xsl:call-template></div><div><xsl:call-template name="cfdi-field"><xsl:with-param name="label">Folio fiscal:</xsl:with-param><xsl:with-param name="value" select="cfdi:Complemento/tfd:TimbreFiscalDigital/@UUID"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label">No. de serie del CSD:</xsl:with-param><xsl:with-param name="value" select="@NoCertificado"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label">Serie / Folio:</xsl:with-param><xsl:with-param name="value" select="concat(@Serie, ' ', @Folio)"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label">C&#243;digo postal de emisi&#243;n:</xsl:with-param><xsl:with-param name="value" select="@LugarExpedicion"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label">Fecha y hora de emisi&#243;n:</xsl:with-param><xsl:with-param name="value" select="@Fecha"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label">Efecto de comprobante:</xsl:with-param><xsl:with-param name="value"><xsl:apply-templates select="@TipoDeComprobante" mode="cfdi:reference-label"/></xsl:with-param></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label">R&#233;gimen fiscal emisor:</xsl:with-param><xsl:with-param name="value"><xsl:apply-templates select="cfdi:Emisor/@RegimenFiscal" mode="cfdi:reference-label"/></xsl:with-param></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label">Exportaci&#243;n:</xsl:with-param><xsl:with-param name="value"><xsl:apply-templates select="@Exportacion" mode="cfdi:reference-label"/></xsl:with-param></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label">Versi&#243;n CFDI:</xsl:with-param><xsl:with-param name="value" select="@Version"/></xsl:call-template></div></header>
<xsl:if test="cfdi:CfdiRelacionados"><section class="cfdi-related"><h3>CFDI relacionados</h3><xsl:for-each select="cfdi:CfdiRelacionados"><p>Tipo de relaci&#243;n: <xsl:value-of select="@TipoRelacion"/></p><xsl:for-each select="cfdi:CfdiRelacionado"><p><xsl:value-of select="@UUID"/></p></xsl:for-each></xsl:for-each></section></xsl:if>
</xsl:template><xsl:template match="@RegimenFiscal | @RegimenFiscalReceptor" mode="cfdi:reference-label"><xsl:choose><xsl:when test=".='601'">601 - General de Ley Personas Morales</xsl:when><xsl:when test=".='612'">612 - Personas F&#237;sicas con Actividades Empresariales y Profesionales</xsl:when><xsl:when test=".='626'">626 - R&#233;gimen Simplificado de Confianza</xsl:when><xsl:otherwise><xsl:value-of select="."/></xsl:otherwise></xsl:choose></xsl:template><xsl:template match="@TipoDeComprobante" mode="cfdi:reference-label"><xsl:choose><xsl:when test=".='I'">I - Ingreso</xsl:when><xsl:when test=".='E'">E - Egreso</xsl:when><xsl:when test=".='P'">P - Pago</xsl:when><xsl:when test=".='T'">T - Traslado</xsl:when><xsl:when test=".='N'">N - N&#243;mina</xsl:when><xsl:otherwise><xsl:value-of select="."/></xsl:otherwise></xsl:choose></xsl:template><xsl:template match="@UsoCFDI" mode="cfdi:reference-label"><xsl:choose><xsl:when test=".='G03'">G03 - Gastos en general</xsl:when><xsl:when test=".='CP01'">CP01 - Pagos</xsl:when><xsl:otherwise><xsl:value-of select="."/></xsl:otherwise></xsl:choose></xsl:template><xsl:template match="@Exportacion" mode="cfdi:reference-label"><xsl:choose><xsl:when test=".='01'">01 - No aplica</xsl:when><xsl:otherwise><xsl:value-of select="."/></xsl:otherwise></xsl:choose></xsl:template></xsl:stylesheet>