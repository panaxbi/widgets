<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:cfdi="http://www.sat.gob.mx/cfd/4" exclude-result-prefixes="cfdi">
    <xsl:template match="cfdi:Impuestos" mode="cfdi:impuestos"><section class="cfdi-panel cfdi-impuestos" aria-label="Impuestos"><h2>Impuestos</h2><div class="cfdi-tax-summary"><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Total impuestos trasladados'"/><xsl:with-param name="value" select="@TotalImpuestosTrasladados"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Total impuestos retenidos'"/><xsl:with-param name="value" select="@TotalImpuestosRetenidos"/></xsl:call-template></div><xsl:if test="cfdi:Traslados/cfdi:Traslado"><h3>Traslados</h3><div class="cfdi-table-wrap"><table class="cfdi-table cfdi-small-table"><thead><tr><th>Base</th><th>Impuesto</th><th>Tipo factor</th><th>Tasa o cuota</th><th>Importe</th></tr></thead><tbody><xsl:apply-templates select="cfdi:Traslados/cfdi:Traslado" mode="cfdi:global-tax-row"/></tbody></table></div></xsl:if><xsl:if test="cfdi:Retenciones/cfdi:Retencion"><h3>Retenciones</h3><div class="cfdi-table-wrap"><table class="cfdi-table cfdi-small-table"><thead><tr><th>Impuesto</th><th>Importe</th></tr></thead><tbody><xsl:apply-templates select="cfdi:Retenciones/cfdi:Retencion" mode="cfdi:global-retention-row"/></tbody></table></div></xsl:if></section></xsl:template>
    <xsl:template match="cfdi:Traslado" mode="cfdi:global-tax-row"><tr><td class="cfdi-money"><xsl:call-template name="cfdi-money"><xsl:with-param name="value" select="@Base"/></xsl:call-template></td><td><xsl:value-of select="@Impuesto"/></td><td><xsl:value-of select="@TipoFactor"/></td><td class="cfdi-number"><xsl:call-template name="cfdi-rate"><xsl:with-param name="value" select="@TasaOCuota"/></xsl:call-template></td><td class="cfdi-money"><xsl:call-template name="cfdi-money"><xsl:with-param name="value" select="@Importe"/></xsl:call-template></td></tr></xsl:template>
    <xsl:template match="cfdi:Retencion" mode="cfdi:global-retention-row"><tr><td><xsl:value-of select="@Impuesto"/></td><td class="cfdi-money"><xsl:call-template name="cfdi-money"><xsl:with-param name="value" select="@Importe"/></xsl:call-template></td></tr></xsl:template>
</xsl:stylesheet>
