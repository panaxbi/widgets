<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:cfdi="http://www.sat.gob.mx/cfd/4" exclude-result-prefixes="cfdi">
    <xsl:template match="cfdi:Comprobante" mode="cfdi:parties"><section class="cfdi-panel cfdi-parties" aria-label="Emisor y receptor"><h2>Datos fiscales</h2><div class="cfdi-two-columns"><xsl:apply-templates select="cfdi:Emisor" mode="cfdi:party"><xsl:with-param name="title" select="'Emisor'"/></xsl:apply-templates><xsl:apply-templates select="cfdi:Receptor" mode="cfdi:party"><xsl:with-param name="title" select="'Receptor'"/></xsl:apply-templates></div></section></xsl:template>
    <xsl:template match="cfdi:Emisor | cfdi:Receptor" mode="cfdi:party"><xsl:param name="title"/><article class="cfdi-party"><h3><xsl:value-of select="$title"/></h3><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'RFC'"/><xsl:with-param name="value" select="@Rfc"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Nombre / Razón social'"/><xsl:with-param name="value" select="@Nombre"/></xsl:call-template><xsl:choose><xsl:when test="self::cfdi:Emisor"><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Régimen fiscal'"/><xsl:with-param name="value" select="@RegimenFiscal"/></xsl:call-template></xsl:when><xsl:otherwise><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Domicilio fiscal'"/><xsl:with-param name="value" select="@DomicilioFiscalReceptor"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Régimen fiscal'"/><xsl:with-param name="value" select="@RegimenFiscalReceptor"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Uso CFDI'"/><xsl:with-param name="value" select="@UsoCFDI"/></xsl:call-template></xsl:otherwise></xsl:choose></article></xsl:template>
</xsl:stylesheet>
