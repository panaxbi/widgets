<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:cfdi="http://www.sat.gob.mx/cfd/4" xmlns:tfd="http://www.sat.gob.mx/TimbreFiscalDigital" exclude-result-prefixes="cfdi tfd">
    <xsl:template match="cfdi:Comprobante" mode="cfdi:sellos"><section class="cfdi-panel cfdi-sellos" aria-label="Sellos digitales"><h2>Sellos digitales</h2><xsl:apply-templates select="." mode="cfdi:sello-cfd"/><xsl:apply-templates select="cfdi:Complemento/tfd:TimbreFiscalDigital" mode="cfdi:sello-sat"/><xsl:apply-templates select="cfdi:Complemento/tfd:TimbreFiscalDigital" mode="cfdi:cadena-original"/></section></xsl:template>
    <xsl:template match="cfdi:Comprobante" mode="cfdi:sello-cfd"><article class="cfdi-seal-block"><h3>Sello digital del CFDI</h3><p><xsl:value-of select="@Sello"/></p></article></xsl:template>
    <xsl:template match="tfd:TimbreFiscalDigital" mode="cfdi:sello-sat"><article class="cfdi-seal-block"><h3>Sello digital del SAT</h3><p><xsl:value-of select="@SelloSAT"/></p></article></xsl:template>
    <xsl:template match="tfd:TimbreFiscalDigital" mode="cfdi:cadena-original"><article class="cfdi-seal-block"><h3>Cadena original del complemento de certificación digital del SAT</h3><p><xsl:text>||</xsl:text><xsl:value-of select="@Version"/><xsl:text>|</xsl:text><xsl:value-of select="@UUID"/><xsl:text>|</xsl:text><xsl:value-of select="@FechaTimbrado"/><xsl:text>|</xsl:text><xsl:value-of select="@RfcProvCertif"/><xsl:text>|</xsl:text><xsl:value-of select="@SelloCFD"/><xsl:text>|</xsl:text><xsl:value-of select="@NoCertificadoSAT"/><xsl:text>||</xsl:text></p></article></xsl:template>
</xsl:stylesheet>
