<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tfd="http://www.sat.gob.mx/TimbreFiscalDigital" xmlns:cfdi="http://www.sat.gob.mx/cfd/4" exclude-result-prefixes="tfd cfdi">
    <xsl:template match="tfd:TimbreFiscalDigital" mode="cfdi:timbre"><section class="cfdi-panel cfdi-timbre" aria-label="Timbre fiscal digital"><h2>Timbre Fiscal Digital</h2><div class="cfdi-data-grid"><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'UUID'"/><xsl:with-param name="value" select="@UUID"/><xsl:with-param name="class" select="'cfdi-wide'"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Fecha timbrado'"/><xsl:with-param name="value" select="@FechaTimbrado"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'RFC proveedor certificación'"/><xsl:with-param name="value" select="@RfcProvCertif"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'No. certificado SAT'"/><xsl:with-param name="value" select="@NoCertificadoSAT"/></xsl:call-template><xsl:call-template name="cfdi-field"><xsl:with-param name="label" select="'Versión timbre'"/><xsl:with-param name="value" select="@Version"/></xsl:call-template></div></section></xsl:template>
    <xsl:template match="text() | @*" mode="cfdi:timbre"/>
</xsl:stylesheet>
